{
  "expo": {
    "name": "Zona Gamer",
    "slug": "ZonaGamer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo sin fondo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo sin fondo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zonagamer1.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAFqA4T_Et_FdpSIHnDTU2zZPDXmla09mg"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo sin fondo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "734b202d-ab45-4764-a732-066eada03365"
      }
    }
  }
}
